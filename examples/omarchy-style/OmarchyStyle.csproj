<Project Sdk="Microsoft.NET.Sdk">
  <!-- In the Winshell repo the example builds against the source, so the main check builds it. A copy outside the repo
       drops this import and the ProjectReference below and references the Winshell package instead: see README.md. -->
  <Import Project="..\..\src\Winshell.Package\buildTransitive\Winshell.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OmarchyStyle</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winshell.Shell\Winshell.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- JetBrainsMono Nerd Font, its licence and its icon sets' licences, copied next to the program. -->
    <Content Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

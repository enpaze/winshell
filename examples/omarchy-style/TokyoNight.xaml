<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Omarchy's Tokyo Night style, whatever the Windows theme is. AppShell sets this file as shell.Style. -->
  <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#1a1b26" />
  <SolidColorBrush x:Key="ShellForegroundBrush" Color="#a9b1d6" />
  <SolidColorBrush x:Key="ShellAlertBrush" Color="#f7768e" />
  <!-- The font file ships next to the program, so it needs no install. -->
  <FontFamily x:Key="ShellFontFamily">ms-appx:///Fonts/JetBrainsMonoNerdFont-Regular.ttf#JetBrainsMono NF</FontFamily>
  <x:Double x:Key="ShellFontSize">12</x:Double>
  <!-- The height of a top or bottom bar, and the width of a left or right one. -->
  <x:Double x:Key="ShellSlotSize">26</x:Double>
  <!-- The space between the widgets and each end of a bar. -->
  <x:Double x:Key="ShellPadding">8</x:Double>

  <!-- A glyph slot a pixel wider than the bar is high. It has no hover fill and no corners, and shrinks a little
       while pressed. Its Alert and NoAlert states are the style contract's: a widget shows its glyph in the alert
       color with Alert. -->
  <Style TargetType="Button">
    <Setter Property="MinWidth" Value="27" />
    <Setter Property="MinHeight" Value="{StaticResource ShellSlotSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ShellForegroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource ShellFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource ShellFontSize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition GeneratedDuration="0:0:0.16">
                    <VisualTransition.GeneratedEasingFunction>
                      <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                    </VisualTransition.GeneratedEasingFunction>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.9"
                                     Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.9"
                                     Duration="0" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="AlertStates">
                <VisualState x:Name="NoAlert" />
                <VisualState x:Name="Alert">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{StaticResource ShellAlertBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
              x:Name="Presenter"
              Content="{TemplateBinding Content}"
              Foreground="{TemplateBinding Foreground}"
              FontFamily="{TemplateBinding FontFamily}"
              FontSize="{TemplateBinding FontSize}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
              <ContentPresenter.RenderTransform>
                <ScaleTransform x:Name="Scale" />
              </ContentPresenter.RenderTransform>
            </ContentPresenter>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ShellForegroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource ShellFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource ShellFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The Nerd Font holds the icons too. -->
  <Style TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{StaticResource ShellFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource ShellFontSize}" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ShellForegroundBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource ShellFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource ShellFontSize}" />
    <Setter Property="BorderBrush" Value="{StaticResource ShellForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="9,6" />
  </Style>
</ResourceDictionary>

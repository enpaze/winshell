<UserControl
  x:Class="OmarchyStyle.PanelView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PanelStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.FontFamily>
    <StaticResource ResourceKey="PanelFont" />
  </UserControl.FontFamily>
  <UserControl.FontSize>
    <StaticResource ResourceKey="PanelFontSize" />
  </UserControl.FontSize>
  <UserControl.Foreground>
    <StaticResource ResourceKey="PanelForeground" />
  </UserControl.Foreground>

  <Grid Background="{StaticResource PanelBackground}" Padding="{StaticResource PanelInset}" Loaded="OnLayoutLoaded">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <TextBlock
        x:Name="WindowsGlyph"
        Width="{StaticResource SlotWidth}"
        TextAlignment="Center"
        VerticalAlignment="Center" />
      <StackPanel x:Name="Workspaces" Orientation="Horizontal" Spacing="1" Margin="0,0,1.5,0" />
    </StackPanel>

    <TextBlock
      x:Name="Clock"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Padding="8.5,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <StackPanel x:Name="Tray" Orientation="Horizontal" Visibility="Collapsed">
        <!-- Hovering the chevron slides the icons Windows keeps in its overflow out beside it. -->
        <StackPanel
          x:Name="Overflow"
          Orientation="Horizontal"
          Background="Transparent"
          PointerEntered="OnOverflowEntered"
          PointerExited="OnOverflowExited">
          <Button x:Name="TrayChevron" Style="{StaticResource PanelButton}" />
          <Grid x:Name="OverflowClip" Width="0">
            <StackPanel x:Name="OverflowItems" Orientation="Horizontal" HorizontalAlignment="Left" />
          </Grid>
        </StackPanel>
        <StackPanel x:Name="PinnedItems" Orientation="Horizontal" />
      </StackPanel>
      <Button x:Name="Bluetooth" Style="{StaticResource PanelButton}" Tag="ms-settings:bluetooth"
              Click="OnSettingsClick" />
      <Button x:Name="Network" Style="{StaticResource PanelButton}" Tag="ms-settings:network-status"
              Click="OnSettingsClick" />
      <Button x:Name="Audio" Style="{StaticResource PanelButton}" Tag="ms-settings:sound" Click="OnSettingsClick" />
      <Button x:Name="Screen" Style="{StaticResource PanelButton}" Tag="ms-settings:display" Click="OnSettingsClick" />
      <Button x:Name="Battery" Style="{StaticResource PanelButton}" Tag="ms-settings:powersleep"
              Click="OnSettingsClick" />
    </StackPanel>
  </Grid>
</UserControl>

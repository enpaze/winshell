<UserControl
  x:Class="OmarchyStyle.PanelView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="using:Winshell">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PanelStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.FontFamily>
    <StaticResource ResourceKey="PanelFont" />
  </UserControl.FontFamily>
  <UserControl.FontSize>
    <StaticResource ResourceKey="PanelFontSize" />
  </UserControl.FontSize>
  <UserControl.Foreground>
    <StaticResource ResourceKey="PanelForeground" />
  </UserControl.Foreground>

  <Grid Background="{StaticResource PanelBackground}" Padding="{StaticResource PanelInset}" Loaded="OnLayoutLoaded">
    <shell:WidgetArea x:Name="StartArea" Theme="ms-appx:///TokyoNight.xaml" HorizontalAlignment="Left"
                      VerticalAlignment="Stretch" />
    <shell:WidgetArea x:Name="CenterArea" Theme="ms-appx:///TokyoNight.xaml" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    <shell:WidgetArea x:Name="EndArea" Theme="ms-appx:///TokyoNight.xaml" HorizontalAlignment="Right"
                      VerticalAlignment="Stretch" />
  </Grid>
</UserControl>

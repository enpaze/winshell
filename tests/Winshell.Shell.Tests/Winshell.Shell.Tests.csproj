<Project Sdk="Microsoft.NET.Sdk">
  <!-- These tests host real WinUI windows, so they run with the settings a configuration gets. -->
  <Import Project="..\..\src\Winshell.Package\buildTransitive\Winshell.props" />
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- xUnit answers discovery by running this program with -assemblyInfo and waiting 60 seconds for it to
         exit. The SDK module initializer loads the self-contained runtime before that process can print anything,
         and on a busy runner the load misses the limit. WindowsAppRuntimeStartup loads the runtime for a real run
         and skips the probe. Leave the undocked initializer compiled in: that startup calls it. -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
  </PropertyGroup>
  <!-- DocsTests compiles the reference generator as a library: the feature lets its #: lines through, and the
       constant leaves out its top-level statements. -->
  <PropertyGroup>
    <Features>$(Features);FileBasedProgram</Features>
    <DefineConstants>$(DefineConstants);REFERENCE_PAGES_LIBRARY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\scripts\generate-reference.cs" Link="ReferencePages.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winshell.Shell\Winshell.Shell.csproj" />
  </ItemGroup>
</Project>

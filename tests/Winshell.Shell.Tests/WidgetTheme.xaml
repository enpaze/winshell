<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="DarkRed" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="LightGreen" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:String x:Key="WidgetThemeMessage">widget theme</x:String>
</ResourceDictionary>

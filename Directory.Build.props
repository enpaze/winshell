<Project>
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>11.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ReactorDiagnostics>false</ReactorDiagnostics>
    <ReactorSourceMap>false</ReactorSourceMap>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <_WinshellReleaseManifest>$(MSBuildThisFileDirectory).release-please-manifest.json</_WinshellReleaseManifest>
    <IsPackable>false</IsPackable>
    <Authors>dante-sparras</Authors>
    <Product>Winshell</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Version)' == '' and Exists('$(_WinshellReleaseManifest)')">
    <_WinshellReleaseManifestText>$([System.IO.File]::ReadAllText('$(_WinshellReleaseManifest)'))</_WinshellReleaseManifestText>
    <_WinshellReleaseVersion>$([System.Text.RegularExpressions.Regex]::Match($(_WinshellReleaseManifestText), '(?&lt;="\."\s*:\s*")[^"]+').Value)</_WinshellReleaseVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Version Condition="'$(Version)' == '' and '$(_WinshellReleaseVersion)' != ''">$(_WinshellReleaseVersion)</Version>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>

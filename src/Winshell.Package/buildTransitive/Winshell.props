<Project>
  <PropertyGroup>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Leave WindowsAppSDKSelfContained unset. The SDK defaults it to true for any project that is not a library,
         so an executable stays self-contained and a widget library builds. -->
    <!-- Windows bitmap-scales a program that does not declare this, so a shell is blurry on a scaled screen and its
         coordinates are not physical pixels. A project that sets ApplicationManifest keeps its own. The Windows App
         SDK merges this into the manifest it embeds. -->
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
    <!-- A shell mostly waits. PGO keeps instrumenting code it will never make hot, and a background GC thread saves pauses
         nobody sees on so small a heap. Together they cost a third of an idle shell's CPU. -->
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Installed widgets live in widgets.props beside the project: ProjectReference and WinshellWidget items. This
       file is read before the project body, so the default stays conditional and -p:WinshellWidgetsFile replaces it.
       The path must be absolute, since a relative Exists resolves against this file's own folder. Items imported
       here still reach the build. -p:WinshellWidgetsFile is global, so a widget project would import the
       configuration's file and reference itself. -p:WinshellWidgetsProject names the configuration; any other
       project keeps the file beside itself. An empty name imports wherever the file exists. -->
  <PropertyGroup>
    <WinshellWidgetsFile Condition="'$(WinshellWidgetsFile)' == ''">$(MSBuildProjectDirectory)\widgets.props</WinshellWidgetsFile>
  </PropertyGroup>
  <Import Project="$(WinshellWidgetsFile)" Condition="Exists('$(WinshellWidgetsFile)') and ('$(WinshellWidgetsProject)' == '' or '$(WinshellWidgetsProject)' == '$(MSBuildProjectFullPath)')" />

  <!-- A WinshellWidget item names a widget and the type the build constructs for it. WinUI compiles once before
       CoreCompile, so the file has to exist before PrepareForBuild; a later target misses that pass. An inline task
       does what plain MSBuild cannot: compare names case-sensitively (item batching ignores case), escape a name that
       contains a quote, a backslash or a new line, and reject a type whose text would break a condition. The task is
       compiled only when the project has items. With none, the target still replaces a generated file an item left
       behind. It runs only for an executable: a library may list items for a tool to read, and must not register
       them a second time. OutputType is the project's, set after this file is read, so the condition is on the
       target, which runs after the project body. A property set here would still see the SDK's earlier default. -->
  <UsingTask TaskName="WinshellGenerateWidgetRegistration" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Widgets ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <ProjectFile ParameterType="System.String" Required="true" />
      <Lines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var failed = false;
        var seen = new HashSet<string>(StringComparer.Ordinal);
        var lines = new List<Microsoft.Build.Framework.ITaskItem>();
        void Add(string line) => lines.Add(new Microsoft.Build.Utilities.TaskItem(line));
        string Literal(string value)
        {
            var builder = new StringBuilder(value.Length + 2);
            builder.Append('"');
            foreach (var c in value)
            {
                if (c == '"' || c == '\\')
                    builder.Append('\\').Append(c);
                else if (c < ' ' || c > '~')
                    builder.Append("\\u").Append(((int)c).ToString("x4"));
                else
                    builder.Append(c);
            }
            builder.Append('"');
            return builder.ToString();
        }
        Add("// <auto-generated/>");
        Add("internal static class WinshellWidgetRegistration");
        Add("{");
        Add("    [global::System.Runtime.CompilerServices.ModuleInitializer]");
        Add("    internal static void Register()");
        Add("    {");
        foreach (var widget in Widgets)
        {
            var name = widget.ItemSpec ?? "";
            var type = widget.GetMetadata("Type");
            var error = string.IsNullOrWhiteSpace(name) ? "The name must not be empty or whitespace."
                : !seen.Add(name) ? "The name is duplicated (names are case-sensitive)."
                : string.IsNullOrWhiteSpace(type) ? "Type is required."
                : !Regex.IsMatch(type, @"\A[\p{L}\p{M}\p{N}\p{Pc}@.<>:,?\[\] \t]+\z") ? "Type '" + type + "' must be a C# type name."
                : "";
            if (error.Length != 0)
            {
                Log.LogError(null, "WSWIDGET001", null, ProjectFile, 0, 0, 0, 0, "WinshellWidget '" + name + "': " + error);
                failed = true;
                continue;
            }
            // The registration line names the widget. A #line path is not a file, and a git checkout embeds it (CS1504).
            Add("        global::Winshell.Widgets.Register(" + Literal(name) + ", context => new " + type + "(context));");
        }
        Add("    }");
        Add("}");
        if (failed)
            return false;
        Lines = lines.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WinshellGenerateWidgets" BeforeTargets="PrepareForBuild" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <PropertyGroup>
      <_WinshellWidgetRegistrationFile>$(IntermediateOutputPath)WinshellWidgetRegistration.g.cs</_WinshellWidgetRegistrationFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup Condition="'@(WinshellWidget)' == ''">
      <_WinshellWidgetRegistrationLines Include="// &lt;auto-generated/&gt;" />
    </ItemGroup>
    <WinshellGenerateWidgetRegistration Condition="'@(WinshellWidget)' != ''" Widgets="@(WinshellWidget)" ProjectFile="$(MSBuildProjectFullPath)">
      <Output TaskParameter="Lines" ItemName="_WinshellWidgetRegistrationLines" />
    </WinshellGenerateWidgetRegistration>
    <WriteLinesToFile File="$(_WinshellWidgetRegistrationFile)" Lines="@(_WinshellWidgetRegistrationLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_WinshellWidgetRegistrationFile)">
        <AutoGen>true</AutoGen>
      </Compile>
      <FileWrites Include="$(_WinshellWidgetRegistrationFile)" />
    </ItemGroup>
  </Target>
</Project>

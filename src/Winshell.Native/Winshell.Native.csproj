<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- GetWindowLongPtr is 64-bit only in the metadata. x64 and arm64 share that signature, and Winshell ships both. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <InternalsVisibleTo Include="Winshell.Core" />
    <InternalsVisibleTo Include="Winshell.Services" />
    <InternalsVisibleTo Include="Winshell.Shell" />
    <!-- Test projects that call Native. The parent-process watch lives in TestSupport, so a test project that does
         not call Native is not a friend. -->
    <InternalsVisibleTo Include="Winshell.Services.Tests" />
    <InternalsVisibleTo Include="Winshell.Shell.Tests" />
    <InternalsVisibleTo Include="Winshell.Tests" />
    <InternalsVisibleTo Include="Winshell.TestSupport" />
  </ItemGroup>
</Project>

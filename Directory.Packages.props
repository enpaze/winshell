<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageVersion Include="Microsoft.UI.Reactor" Version="0.1.0-preview.17" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.15" />
    <PackageVersion Include="System.Management" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="MSTest" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>
</Project>

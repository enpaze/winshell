<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyShell</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Winshell" Version="__WINSHELL_VERSION__" />
  </ItemGroup>
  <!-- Each widget: the name a bar or widget area places it by, and its class. -->
  <ItemGroup>
    <WinshellWidget Include="clock" Type="MyShell.Clock" />
    <WinshellWidget Include="battery" Type="MyShell.Battery" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="product" required="true" />
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="${product}" product-version="${version}">
      <include path="win-x64/winshell.exe" />
      <include path="win-x64/winshellw.exe" />
      <include path="win-x64/winshell.dll" />
      <include path="win-x64/Winshell.Native.dll" />
      <include path="win-x64/Winshell.Core.dll" />
      <include path="win-x64/Winshell.Services.dll" />
      <include path="win-x64/Winshell.Shell.dll" />
      <include path="win-arm64/winshell.exe" />
      <include path="win-arm64/winshellw.exe" />
      <include path="win-arm64/winshell.dll" />
      <include path="win-arm64/Winshell.Native.dll" />
      <include path="win-arm64/Winshell.Core.dll" />
      <include path="win-arm64/Winshell.Services.dll" />
      <include path="win-arm64/Winshell.Shell.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>

  {
    "id": "command.dev",
    "kind": "command",
    "name": "dev",
    "summary": "Runs a project under dotnet watch. The driver starts it in the background and waits until winshell list shows the shell's Debug build running.",
    "code": [
      "src/Winshell/Commands/DevCommand.cs",
      "src/Winshell/DevSession.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "dev",
          "-p",
          "{shell}"
        ],
        "background": true
      },
      {
        "winshell": [
          "list",
          "-j"
        ],
        "output": "Debug[^\"]*FeatureShell\\.exe",
        "within": 600
      }
    ]
  },
  {
    "id": "command.doctor",
    "kind": "command",
    "name": "doctor",
    "summary": "Checks this PC's setup for a project and prints the checks as JSON.",
    "code": [
      "src/Winshell/Commands/DoctorCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "doctor",
          "-p",
          "{shell}",
          "-j"
        ],
        "exit": [
          0,
          1
        ],
        "output": "\"id\": \"built\",\\s*\"title\": \"Built\",\\s*\"status\": \"pass\""
      }
    ]
  },
  {
    "id": "command.help",
    "kind": "command",
    "name": "help",
    "summary": "Prints a command's usage.",
    "code": [
      "src/Winshell/CliParser.cs"
    ],
    "shell": "none",
    "steps": [
      {
        "winshell": [
          "help",
          "list"
        ],
        "output": "^winshell list"
      }
    ]
  },
  {
    "id": "command.inspect-click",
    "kind": "command",
    "name": "inspect click",
    "summary": "Activates a button through its automation peer, and the feature window's click count goes up.",
    "code": [
      "src/Winshell/Commands/InspectCommand.cs",
      "src/Winshell.Shell/Inspector.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "inspect",
          "--pid",
          "{pid}",
          "click",
          "features.click"
        ],
        "output": "^Clicked features\\.click$"
      },
      {
        "element": "features.clicks",
        "has": {
          "text": "^clicks: [1-9][0-9]*$"
        }
      }
    ]
  },
  {
    "id": "command.inspect-focus",
    "kind": "command",
    "name": "inspect focus",
    "summary": "Real input. The driver names an element that is not there, so the shell refuses before it sends any input.",

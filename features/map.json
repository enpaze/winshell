  {
    "id": "command.ipc-listen",
    "kind": "command",
    "name": "ipc listen",
    "summary": "Prints each signal the shell raises. The feature shell raises one a second.",
    "code": [
      "src/Winshell/Commands/IpcCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "ipc",
          "--pid",
          "{pid}",
          "listen",
          "features",
          "ticked"
        ],
        "for": 4,
        "output": "^[0-9]+\\r?\\n[0-9]+"
      }
    ]
  },
  {
    "id": "command.ipc-show",
    "kind": "command",
    "name": "ipc show",
    "summary": "Lists the shell's IPC targets as JSON.",
    "code": [
      "src/Winshell/Commands/IpcCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "ipc",
          "--pid",
          "{pid}",
          "show",
          "-j"
        ],
        "output": "\"target\": \"features\""
      }
    ]
  },
  {
    "id": "command.ipc-wait",
    "kind": "command",
    "name": "ipc wait",
    "summary": "Waits for one signal and prints its argument.",
    "code": [
      "src/Winshell/Commands/IpcCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [

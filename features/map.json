[
  {
    "id": "block.bar",
    "kind": "block",
    "name": "Bar",
    "summary": "The starter's bar, a panel window on each screen with the clock in its center area. It reserves the top edge while it runs.",
    "code": [
      "src/Winshell.Shell/Compositions/Bar.cs"
    ],
    "shell": "starter",
    "steps": [
      {
        "element": "Clock",
        "window": "PanelWindow",
        "has": {
          "text": "^[0-9]{1,2}[:.][0-9]{2}"
        }
      }
    ]
  },
  {
    "id": "block.capture-view",
    "kind": "block",
    "name": "CaptureView",
    "summary": "A capture view of the feature window: capture view: running, frame WxH.",
    "code": [
      "src/Winshell.Shell/CaptureView.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "element": "block.capture-view",
        "has": {
          "label": "^capture view: running, frame [1-9][0-9]*x[1-9][0-9]*$"
        },
        "within": 20
      }
    ]
  },
  {
    "id": "block.floating-window",
    "kind": "block",
    "name": "FloatingWindow",
    "summary": "The feature window: floating window: WxH.",
    "code": [
      "src/Winshell.Shell/FloatingWindow.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "element": "block.floating-window",
        "window": "FloatingWindow",
        "has": {
          "text": "^floating window: [1-9][0-9]*x[1-9][0-9]*$"
        }
      }
    ]
  },
  {
    "id": "block.panel-window",
    "kind": "block",
    "name": "PanelWindow",
    "summary": "A small panel window at the top left that reserves nothing and sits behind other windows: panel window: WxH.",
    "code": [
      "src/Winshell.Shell/PanelWindow.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "element": "block.panel-window",
        "window": "PanelWindow",
        "has": {
          "text": "^panel window: [1-9][0-9]*x[1-9][0-9]*$"
        }
      }
    ]
  },
  {
    "id": "block.popup-window",
    "kind": "block",
    "name": "PopupWindow",
    "summary": "The popup window the feature window's Popup button opens: popup window: WxH.",
    "code": [
      "src/Winshell.Shell/PopupWindow.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "inspect",
          "--pid",
          "{pid}",
          "click",
          "features.popup"
        ],
        "output": "^Clicked features\\.popup$"
      },
      {
        "element": "block.popup-window",
        "window": "PopupWindow",
        "has": {
          "text": "^popup window: [1-9][0-9]*x[1-9][0-9]*$"
        }
      }
    ]
  },
  {
    "id": "block.surface",
    "kind": "block",
    "name": "Surface",

          "--pid",
          "{pid}",
          "wait",
          "features",
          "ticked"
        ],
        "output": "^[0-9]+$"
      }
    ]
  },
  {
    "id": "command.kill",
    "kind": "command",
    "name": "kill",
    "summary": "Stops the shell and waits until it has exited. Nothing is left running.",
    "code": [
      "src/Winshell/Commands/KillCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "kill",
          "--pid",
          "{pid}"
        ],
        "output": "^Killed "
      },
      {
        "winshell": [
          "list",
          "-j"
        ],
        "output": "^\\[\\]$"
      }
    ]
  },
  {
    "id": "command.log",
    "kind": "command",
    "name": "log",
    "summary": "Prints the end of the shell's log.",
    "code": [
      "src/Winshell/Commands/LogCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "log",
          "--pid",
          "{pid}",
          "-t",
          "20"
        ],
        "output": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3} +INFO shell: Winshell "
      }
    ]
  },
  {
    "id": "command.new",
    "kind": "command",
    "name": "new",
    "summary": "Lists the starter and examples, then copies the starter into a new folder.",
    "code": [
      "src/Winshell/Commands/NewCommand.cs",
      "src/Winshell/Example.cs"
    ],
    "shell": "none",
    "steps": [
      {
        "winshell": [
          "new"
        ],
        "output": "^  starter "
      },
      {
        "winshell": [
          "new",
          "starter",
          "-p",
          "{scratch}/starter"
        ],
        "output": "^Created ",
        "file": "{scratch}/starter/MyShell.csproj"
      }
    ]
  },
  {
    "id": "command.reload",
    "kind": "command",
    "name": "reload",
    "summary": "Rebuilds the project and replaces the running shell with a new process, whose click count starts again at 0.",
    "code": [
      "src/Winshell/Commands/ReloadCommand.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "reload",
          "--pid",
          "{pid}"
        ],
        "output": "^Reloaded "
      },
      {
        "element": "features.clicks",
        "has": {
          "text": "^clicks: 0$"
        },
        "within": 60
      }
    ]
  },
  {
    "id": "command.run",
    "kind": "command",
    "name": "run",
    "summary": "Starts the project in the background once the running shell has stopped.",
    "code": [
      "src/Winshell/Commands/RunCommand.cs",
      "src/Winshell/ShellSupervisor.cs"
    ],
    "shell": "features",
    "steps": [
      {
        "winshell": [
          "kill",
          "--pid",
          "{pid}"
        ],
        "output": "^Killed "
      },
      {
        "winshell": [
          "run",
          "-d",
          "-p",
          "{shell}"
        ]
      },
      {
        "winshell": [
          "list",
          "-j"
        ],
        "output": "FeatureShell\\.exe",
        "within": 30
      }
    ]
  },
  {
    "id": "command.use",
    "kind": "command",
    "name": "use",
    "summary": "Chooses the running config as the one winshell run starts, and lists it as chosen.",
    "code": [
      "src/Winshell/Commands/UseCommand.cs"
    ],
